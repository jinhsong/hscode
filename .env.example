# 공공데이터포털(data.go.kr) 발급 일반 인증키 (Decoding 키 권장)
# 비워두면 데모 모드(내장 샘플 DB)로 동작합니다.
DATA_GO_KR_SERVICE_KEY=

# 전파인증: 국립전파연구원_적합성평가 DB정보 (data.go.kr/data/3034183)
# 활용신청 상세의 '요청주소(End Point)'를 그대로 붙여넣으세요.
RRA_API_URL=
RRA_SEARCH_PARAM=searchVal

# KC 안전인증: 국가기술표준원_제품 안전인증 및 리콜 정보 (data.go.kr/data/15116894)
KC_API_URL=
KC_SEARCH_PARAM=modelNm
