# ──────────────────────────────────────────────────────────────
# 전파인증 (방송통신기자재 적합성평가) — 키 불필요!
# ──────────────────────────────────────────────────────────────
# EMSIT 공개 API(getAuthInfo)를 기본으로 사용하므로 아무 설정 없이 바로 실제 조회됩니다.
# 다른 엔드포인트로 바꾸고 싶을 때만 아래를 채우세요. (비우면 EMSIT 기본값 사용)
RRA_API_URL=

# ──────────────────────────────────────────────────────────────
# KC 전기용품 안전인증 — 공공데이터포털 인증키 필요
# ──────────────────────────────────────────────────────────────
# data.go.kr 발급 일반 인증키. 비워두면 KC는 데모(샘플)로만 동작합니다.
DATA_GO_KR_SERVICE_KEY=
# 국가기술표준원_제품 안전인증 및 리콜 정보 (data.go.kr/data/15116894)
# 활용신청 상세의 '요청주소(End Point)'를 붙여넣으세요.
KC_API_URL=
KC_SEARCH_PARAM=modelNm

# ──────────────────────────────────────────────────────────────
# 옵션
# ──────────────────────────────────────────────────────────────
FORCE_DEMO=        # 1 로 두면 외부 호출 없이 전부 내장 샘플로 동작 (오프라인 테스트용)
MIN_PREFIX_LEN=5   # prefix 매칭 오탐 방지를 위한 최소 매칭 길이
MAX_WORKERS=4      # 대량 조회 시 동시 API 호출 수 (rate-limit 고려)

# 서버 바인딩 (선택 / Docker는 0.0.0.0)
HOST=127.0.0.1
PORT=5000
DEBUG=1
